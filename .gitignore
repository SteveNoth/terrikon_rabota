# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
.pytest_cache/
.venv/
venv/
__pycache__/
*.py[cod]

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Логи парсеров (раздел 11.6): jsonl уходит артефактом Actions, не в git и не в базу
/logs/*
!/logs/.gitkeep

# Telegram Telethon: файл сессии = полноценный вход. Строка — в GitHub Secrets, не сюда.
*.session
*.session-journal

# vercel
.vercel

# Next.js agent rule files (project rules live in the prompt markdown files)
AGENTS.md
CLAUDE.md

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# MapLibre worker и CSS (копия из node_modules, собирается scripts/copy-maplibre-worker.mjs)
/public/maplibre/
