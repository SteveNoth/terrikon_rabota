# База данных (Supabase Postgres)
# DATABASE_URL — пул, порт 6543, в конце ?pgbouncer=true (запросы сайта)
# DIRECT_URL — session/direct, порт 5432 (миграции Prisma)
DATABASE_URL=
DIRECT_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Защита служебных запросов. CRON_SECRET — не короче 32 символов.
# PowerShell:
# [BitConverter]::ToString([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32)).Replace('-','').ToLower()
CRON_SECRET=
ADMIN_PASSWORD=

# Telegram
TELEGRAM_BOT_TOKEN=

# Выбор реализаций адаптеров (Закон 6)
MAPS_PROVIDER=maplibre
OCR_PROVIDER=none               # none | tesseract — текст с картинок постов (раздел 11.15)
# Tesseract — системная программа, не pip. Пока не установлен, оставь none: конвейер жив.
# Windows, после установки: OCR_PROVIDER=tesseract
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# TESSDATA_PREFIX=C:\Program Files\Tesseract-OCR\tessdata
CACHE_DRIVER=memory
STORAGE_DRIVER=external
SEARCH_DRIVER=postgres
NOTIFY_DRIVER=telegram

# Ключи карт (нужны только если MAPS_PROVIDER=yandex)
YANDEX_MAPS_API_KEY=
YANDEX_GEOCODER_API_KEY=

# Геокодер Nominatim: честный User-Agent с названием приложения и ссылкой (правила OSM).
# Если пусто — соберём из NEXT_PUBLIC_SITE_URL или репозитория.
GEOCODE_USER_AGENT=

# Поведение сайта
NEXT_PUBLIC_DEFAULT_CITY=gorlovka
NEXT_PUBLIC_DEFAULT_QUALITY_MODE=lite
NEXT_PUBLIC_DEFAULT_STATS_VIEW=simple
NEXT_PUBLIC_SITE_URL=
# Адрес сайта для скриптов парсера (send_test.py). Локально — http://127.0.0.1:3000
SITE_URL=

# Модуль поддержки проекта. false, пока сайт на бесплатном Vercel (см. разделы 5.4 и 12)
NEXT_PUBLIC_DONATIONS_ENABLED=false

# Слой ИИ для трудных объявлений (раздел 11.13). none — сайт полностью работает на правилах
AI_PROVIDER=none
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_MAX_CALLS_PER_RUN=50
AI_MIN_COMPLETENESS=60
