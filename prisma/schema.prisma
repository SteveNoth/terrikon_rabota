// Террикон Работа — модель данных (раздел 10 ядра).
// Меняем схему здесь и накатываем миграцией. Руками таблицы в Supabase не трогаем:
// интерфейс не знает про индексы, связи и откат, и через месяц нельзя повторить то же состояние.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- Перечисления ---

enum SalaryPeriod {
  MONTH
  SHIFT
  HOUR
  PIECE
}

enum WorkFormat {
  LOCAL
  VAHTA
  REMOTE
}

enum EmployerKind {
  DIRECT
  AGENCY
  UNKNOWN
}

enum Experience {
  NONE
  UP_TO_1
  FROM_1_TO_3
  FROM_3
}

enum EmploymentType {
  FULL
  PART
  SHIFT
  TEMPORARY
  REMOTE
}

enum Source {
  VK
  TELEGRAM
  WEBSITE
  TRUDVSEM
  MANUAL
  EMPLOYER
}

enum ModerationStatus {
  AUTO_OK
  PENDING
  APPROVED
  REJECTED
  BLOCKED
}

enum UserRole {
  SEEKER
  EMPLOYER
  ADMIN
}

enum AccountBlockScope {
  PUBLISH
  APPLY
  LOGIN
}

enum ApplicationStatus {
  SENT
  VIEWED
  INVITED
  REJECTED
}

enum ParsedPostStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReportStatus {
  NEW
  REVIEWED
  RESOLVED
}

enum EventType {
  VACANCY_VIEW
  VACANCY_LIST
  SEARCH
  FILTER_APPLY
  APPLY_START
  APPLY_SENT
  FAVORITE_ADD
  CONTACT_CLICK
  MAP_OPEN
  SOURCE_CLICK
}

enum DeviceClass {
  MOBILE
  DESKTOP
}

enum ContactVerdictKind {
  TRUSTED
  BLOCKED
}

enum GeocodeAccuracy {
  EXACT
  DISTRICT
  CITY
}

// --- Основные таблицы ---

model Vacancy {
  id     String @id @default(cuid())
  slug   String @unique
  title  String

  /// Как было в источнике. Для проверок и админки, не для карточки.
  titleOriginal   String?
  titleNormalized String

  /// Оригинал поста. Пишется один раз и не меняется никогда.
  /// Единственное, что позволит переобработать базу, когда правила станут лучше.
  rawText String? @db.Text

  /// Распознанный текст картинок того же поста. Можно обновить, если OCR_VERSION вырос.
  ocrText String? @db.Text

  /// Ссылки на картинки источника, не файлы (Закон 10).
  imageUrls Json?

  /// 0 у неразрезанного поста и у первой единицы; дальше 1, 2… (раздел 11.15).
  splitIndex Int @default(0)

  /// id исходного поста без суффикса #2. У всех детей одного поста одинаковый.
  sourcePostExternalId String

  /// Версия OCR / нарезки, которой получены ocrText и splitIndex.
  /// Нужны reprocess.py: не затирать лучшее распознавание и знать, какой резкой резали.
  ocrVersion      String?
  splitterVersion String?

  /// Обработанное описание, которое видит пользователь. Закон 10: не длиннее 3000.
  description         String  @db.VarChar(3000)
  descriptionSections Json?
  summaryLine         String?
  completeness        Int     @default(0)
  normalizerVersion   String

  aiProcessed      Boolean @default(false)
  aiModel          String?
  aiPromptVersion  String?
  aiConfidence     Int?
  needsAiReview    Boolean @default(false)
  needsHumanReview Boolean @default(false)

  salaryFrom     Int?
  salaryTo       Int?
  salaryText     String?
  salaryCurrency String        @default("RUB")
  salaryPeriod   SalaryPeriod  @default(MONTH)

  /// Город набора / город вакансии. Строка, не enum: список городов живёт в shared/geo.json.
  citySlug         String
  districtSlug     String?
  address          String?
  latitude         Float?
  longitude        Float?
  /// exact — геокодер узнал адрес; district/city — запасная точка, чтобы не врать.
  geocodeAccuracy  GeocodeAccuracy?

  /// LOCAL / VAHTA / REMOTE. У вахты два места: citySlug — откуда набирают, work* — где работа (Закон 17).
  workFormat       WorkFormat   @default(LOCAL)
  workLocationText String?
  workCitySlug     String?
  rotationPattern  String?
  vahtaDays        Int?
  housingProvided  Boolean      @default(false)
  mealsProvided    Boolean      @default(false)
  travelPaid       Boolean      @default(false)
  advancePayment   Boolean      @default(false)
  employerKind     EmployerKind @default(UNKNOWN)

  sphere         String
  professionSlug String?
  /// Вахтовая ротация живёт в rotationPattern, не здесь.
  schedule       String?
  hoursPerDay    Int?
  experience     Experience?
  employmentType EmploymentType?

  contactPhone    String?
  contactTelegram String?
  contactEmail    String?

  source     Source
  sourceName String?
  sourceUrl  String?
  externalId String

  /// true — в источнике до вычета налога (ЦЗН / «Работа России»); false — «на руки»; null — неизвестно (13.3).
  salaryIsGross Boolean?
  /// ИНН работодателя, если источник его дал. Пятый уровень дублей (11.21).
  employerInn   String?
  /// Когда сняли с публикации, потому что исчезла у официального источника. Не удаление.
  archivedAt    DateTime?

  contentHash   String
  duplicateOfId String?
  duplicateOf   Vacancy?  @relation("VacancyDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates    Vacancy[] @relation("VacancyDuplicates")

  signature String
  groupId   String?
  group     VacancyGroup? @relation("VacancyGroupMembers", fields: [groupId], references: [id], onDelete: SetNull)

  qualityScore     Int              @default(0)
  trustScore       Int              @default(0)
  trustFlags       Json             @default("[]")
  moderationStatus ModerationStatus @default(PENDING)
  reviewedAt       DateTime?
  reviewedBy       String?

  isActive    Boolean  @default(true)
  publishedAt DateTime
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  viewsCount  Int      @default(0)

  employerId String?
  employer   Employer? @relation(fields: [employerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  primaryOfGroups     VacancyGroup[]       @relation("GroupPrimary")
  applications        Application[]
  favorites           Favorite[]
  reports             Report[]
  moderationDecisions ModerationDecision[]
  events              Event[]
  telegramDeliveries  TelegramDelivery[]

  @@unique([source, externalId])
  @@index([citySlug])
  @@index([isActive])
  @@index([publishedAt])
  @@index([sphere])
  @@index([contentHash])
  @@index([signature])
  @@index([moderationStatus])
  @@index([employerInn])
  @@index([sourcePostExternalId])
  @@index([source, sourcePostExternalId])
  @@index([contactPhone])
  /// Главная выдача: город + активные + местные/вахта + свежесть.
  @@index([citySlug, isActive, workFormat, publishedAt])
  /// Очистка Этапа 25: не встречались N дней / неактивные старше 60.
  @@index([isActive, lastSeenAt])
}

model Employer {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  /// Если заполнено — уникально. Несколько пустых ИНН в Postgres допустимы.
  inn         String?  @unique
  description String?  @db.Text
  citySlug    String
  sphere      String
  isVerified  Boolean  @default(false)
  /// Только внешняя ссылка, файлы в базе не храним (Закон 10).
  logoUrl     String?
  phone       String?
  telegram    String?
  email       String?
  website     String?
  /// Аккаунт, которому принадлежит карточка компании. У работодателей с парсеров пусто.
  userId      String?  @unique
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vacancies Vacancy[]
  events    Event[]
  stats     EmployerStatDaily[]
}

model Category {
  id           String @id @default(cuid())
  slug         String @unique
  name         String
  icon         String
  order        Int
  vacancyCount Int    @default(0)
}

/// Счётчик местных и вахт по городу. Пересчёт раз в час (Этап 25), страницы не делают COUNT.
model CityStat {
  citySlug     String   @id
  vacancyCount Int      @default(0)
  vahtaCount   Int      @default(0)
  updatedAt    DateTime @updatedAt
}

/// Счётчик местных вакансий сферы в городе. Главная читает отсюда, не группирует Vacancy.
model SphereStat {
  citySlug     String
  sphere       String
  vacancyCount Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@id([citySlug, sphere])
}

model Profession {
  id       String   @id @default(cuid())
  slug     String   @unique
  name     String
  sphere   String
  synonyms String[] @default([])
}

model User {
  id            String   @id @default(cuid())
  /// Id в сервисе входа (Supabase Auth). Свой id не меняем: сменим поставщика — таблица живая.
  authId        String   @unique
  email         String   @unique
  name          String
  role          UserRole @default(SEEKER)
  phone         String?
  citySlug      String
  preferredMode String   @default("lite")
  /// Текст резюме. Файлы не храним (Закон 10).
  resumeText    String?  @db.Text
  /// Ссылка на внешнее резюме (hh, Google Docs и т.п.).
  resumeUrl     String?
  notifyTelegram Boolean @default(false)
  /// Код привязки к Telegram-боту. Ссылка с этим кодом живёт в кабинете.
  telegramLinkCode String? @unique
  /// Дешёвая проверка в гардах. Смена флага всегда пишет AccountBlock.
  publishBlocked Boolean @default(false)
  applyBlocked   Boolean @default(false)
  loginBlocked   Boolean @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  applications  Application[]
  favorites     Favorite[]
  employer      Employer?
  accountBlocks AccountBlock[]
  telegramUser  TelegramUser?
}

/// Журнал блока аккаунта. Флаги на User — для проверки, эта таблица — источник правды.
model AccountBlock {
  id         String            @id @default(cuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope      AccountBlockScope
  /// Внутренняя пометка, не для кабинета.
  reason     String
  /// Фраза человеку. Для PUBLISH показывается в кабинете.
  publicNote String
  decidedBy  String
  createdAt  DateTime          @default(now())
  liftedAt   DateTime?
  liftedBy   String?

  @@index([userId, scope, liftedAt])
}

model Application {
  id        String            @id @default(cuid())
  userId    String
  vacancyId String
  message   String?           @db.Text
  status    ApplicationStatus @default(SENT)
  createdAt DateTime          @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  vacancy Vacancy @relation(fields: [vacancyId], references: [id], onDelete: Cascade)

  @@unique([userId, vacancyId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  vacancyId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  vacancy Vacancy @relation(fields: [vacancyId], references: [id], onDelete: Cascade)

  @@unique([userId, vacancyId])
}

model TelegramUser {
  id             String    @id @default(cuid())
  chatId         String    @unique
  citySlug       String
  keywords       String[]  @default([])
  spheres        String[]  @default([])
  isActive       Boolean   @default(true)
  lastNotifiedAt DateTime?
  /// idle | keywords | sphere | link — шаг диалога. На serverless нельзя держать это в памяти.
  dialog         String    @default("idle")
  pendingKeywords String[] @default([])
  userId         String?   @unique
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  deliveries     TelegramDelivery[]

  @@index([citySlug, isActive])
  @@index([isActive, lastNotifiedAt])
}

/// Одна вакансия (или группа дублей) — одно сообщение подписчику.
model TelegramDelivery {
  id             String   @id @default(cuid())
  telegramUserId String
  vacancyId      String
  /// groupId группы дублей или id вакансии, если группы нет.
  groupKey       String
  sentAt         DateTime @default(now())

  telegramUser TelegramUser @relation(fields: [telegramUserId], references: [id], onDelete: Cascade)
  vacancy      Vacancy      @relation(fields: [vacancyId], references: [id], onDelete: Cascade)

  @@unique([telegramUserId, groupKey])
  @@index([telegramUserId, sentAt])
  @@index([vacancyId])
}

model ParsedPost {
  id           String           @id @default(cuid())
  source       Source
  externalId   String
  rawText      String           @db.Text
  sourceUrl    String?
  detectedCity String?
  filterScore  Int
  filterReasons Json
  status       ParsedPostStatus @default(PENDING)
  createdAt    DateTime         @default(now())

  @@unique([source, externalId])
  @@index([status, createdAt])
}

model ParserRun {
  id                String    @id @default(cuid())
  parser            String
  startedAt         DateTime
  finishedAt        DateTime?
  postsSeen         Int       @default(0)
  postsAccepted     Int       @default(0)
  postsRejected     Int       @default(0)
  /// Сколько из пачки ушло в очередь одобрения (PENDING). Для графика в админке.
  postsPending      Int       @default(0)
  /// Жёсткие флаги / чёрный список — в очередь не идут.
  postsBlocked      Int       @default(0)
  /// Снимок причин отказа: { "svo": 3, "город не active": 2 }.
  rejectReasons     Json?
  vacanciesCreated  Int       @default(0)
  vacanciesUpdated  Int       @default(0)
  errorsCount       Int       @default(0)

  @@index([startedAt])
}

model Report {
  id        String       @id @default(cuid())
  vacancyId String
  reason    String
  comment   String?      @db.Text
  status    ReportStatus @default(NEW)
  createdAt DateTime     @default(now())

  vacancy Vacancy @relation(fields: [vacancyId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model CityWaitlist {
  id        String   @id @default(cuid())
  citySlug  String
  contact   String
  createdAt DateTime @default(now())

  @@index([citySlug])
}

model GeocodeCache {
  id        String           @id @default(cuid())
  query     String           @unique
  lat       Float
  lng       Float
  provider  String
  accuracy  GeocodeAccuracy
  createdAt DateTime         @default(now())
}

model VacancyGroup {
  id                  String   @id @default(cuid())
  signature           String   @unique
  primaryVacancyId    String
  postingsCount       Int      @default(1)
  sourcesCount        Int      @default(1)
  distinctPhonesCount Int      @default(1)
  firstSeenAt         DateTime
  lastSeenAt          DateTime

  primaryVacancy Vacancy   @relation("GroupPrimary", fields: [primaryVacancyId], references: [id], onDelete: Restrict)
  vacancies      Vacancy[] @relation("VacancyGroupMembers")
}

model ContactVerdict {
  id             String             @id @default(cuid())
  contact        String             @unique
  verdict        ContactVerdictKind
  reason         String
  decidedAt      DateTime           @default(now())
  vacanciesCount Int                @default(0)
}

model ModerationDecision {
  id             String   @id @default(cuid())
  vacancyId      String
  decision       String
  triggeredRules Json
  comment        String?  @db.Text
  decidedAt      DateTime @default(now())

  vacancy Vacancy @relation(fields: [vacancyId], references: [id], onDelete: Cascade)

  @@index([vacancyId, decidedAt])
}

model NormalizationSample {
  id                String   @id @default(cuid())
  sourceText        String   @db.Text
  expectedTitle     String
  expectedSections  Json?
  expectedFields    Json
  correctedBy       String
  normalizerVersion String
  createdAt         DateTime @default(now())
}

model AiUsage {
  id              String   @id @default(cuid())
  date            DateTime @db.Date
  provider        String
  model           String
  taskType        String
  calls           Int      @default(0)
  inputChars      Int      @default(0)
  outputChars     Int      @default(0)
  costEstimate    Float    @default(0)
  rejectedByCheck Int      @default(0)
  cacheHits       Int      @default(0)

  @@unique([date, provider, model, taskType])
}

model AiCache {
  id        String   @id @default(cuid())
  key       String   @unique
  result    Json
  model     String
  createdAt DateTime @default(now())
}

// --- Статистика (раздел 10.3). Заводим сразу: события нельзя собрать за прошедшее время. ---

model Event {
  id             String      @id @default(cuid())
  type           EventType
  vacancyId      String?
  employerId     String?
  citySlug       String
  districtSlug   String?
  sphere         String?
  professionSlug String?
  /// Обрезанный запрос, только для частотного анализа. Не полный поисковый лог.
  queryText      String?     @db.VarChar(120)
  /// Случайное значение на 24 часа. Не userId и не IP (Закон 14).
  sessionHash    String
  deviceClass    DeviceClass
  qualityMode    String
  createdAt      DateTime    @default(now())

  vacancy  Vacancy?  @relation(fields: [vacancyId], references: [id], onDelete: SetNull)
  employer Employer? @relation(fields: [employerId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([type, createdAt])
  @@index([citySlug, createdAt])
}

model StatDaily {
  id                    String   @id @default(cuid())
  date                  DateTime @db.Date
  citySlug              String
  /// '*' означает «все» — так уникальный ключ работает без пустых значений.
  sphere                String
  professionSlug        String
  vacanciesActive       Int      @default(0)
  vacanciesNew          Int      @default(0)
  vacanciesClosed       Int      @default(0)
  views                 Int      @default(0)
  listViews             Int      @default(0)
  searches              Int      @default(0)
  applications          Int      @default(0)
  favorites             Int      @default(0)
  contactClicks         Int      @default(0)
  salaryP25             Int?
  salaryP50             Int?
  salaryP75             Int?
  salaryCount           Int      @default(0)
  noSalaryCount         Int      @default(0)
  medianDaysToFirstApply Int?
  medianLifetimeDays    Int?

  @@unique([date, citySlug, sphere, professionSlug])
}

model EmployerStatDaily {
  id               String   @id @default(cuid())
  date             DateTime @db.Date
  employerId        String
  /// Id вакансии или '*' — сводка по всем вакансиям работодателя за день (как в StatDaily).
  vacancyId         String
  listViews         Int      @default(0)
  views             Int      @default(0)
  applications      Int      @default(0)
  favorites         Int      @default(0)
  contactClicks     Int      @default(0)
  avgPositionInList Float?

  employer Employer @relation(fields: [employerId], references: [id], onDelete: Cascade)

  @@unique([date, employerId, vacancyId])
}

model MarketSnapshotMonthly {
  id               String   @id @default(cuid())
  month            DateTime @db.Date
  citySlug         String
  sphere           String
  professionSlug   String
  salaryP25        Int?
  salaryP50        Int?
  salaryP75        Int?
  vacanciesCount   Int      @default(0)
  deficitIndex     Float?
  competitionIndex Float?
  noSalaryShare    Float?
  sampleSize       Int      @default(0)

  @@unique([month, citySlug, sphere, professionSlug])
}

model StatsRun {
  id              String    @id @default(cuid())
  date            DateTime  @db.Date
  startedAt       DateTime
  finishedAt      DateTime?
  eventsProcessed Int       @default(0)
  rowsWritten     Int       @default(0)
  errors          Int       @default(0)
}

model SearchQueryStat {
  id              String   @id @default(cuid())
  month           DateTime @db.Date
  citySlug        String
  queryNormalized String
  count           Int      @default(0)
  resultsAvgCount Float    @default(0)

  @@unique([month, citySlug, queryNormalized])
}

/// Замер реальной загрузки (Этап 24). Только числа и режим, без сессии и IP.
model RumSample {
  id          String   @id @default(cuid())
  qualityMode String
  lcpMs       Int?
  cls         Float?
  inpMs       Int?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([qualityMode, createdAt])
}

/// Чтобы одно и то же «парсер затих» не слать в Telegram каждый час.
model OpsAlert {
  id       String   @id @default(cuid())
  alertKey String   @unique
  sentAt   DateTime
}

/// Еженедельный снимок размера базы (Этап 25). Нужен прогнозу «на сколько хватит».
model DbSizeSample {
  id          String   @id @default(cuid())
  capturedAt  DateTime @default(now())
  bytes       Int
  tableCounts Json
  vacancyRows Int      @default(0)

  @@index([capturedAt])
}
