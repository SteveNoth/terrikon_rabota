# База данных (Supabase Postgres)
# DATABASE_URL — пул, порт 6543, в конце ?pgbouncer=true (запросы сайта)
# DIRECT_URL — session/direct, порт 5432 (миграции Prisma)
DATABASE_URL=
DIRECT_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Защита служебных запросов. CRON_SECRET — не короче 32 символов.
# PowerShell:
# [BitConverter]::ToString([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32)).Replace('-','').ToLower()
CRON_SECRET=
# Админка /admin. Один общий пароль, сессия в подписанной cookie. Не короче 8 символов.
# Пустое значение — админка закрыта целиком.
ADMIN_PASSWORD=

# Telegram Bot API — бот уведомлений (Этап 22), не парсер каналов
TELEGRAM_BOT_TOKEN=

# Выбор реализаций адаптеров (Закон 6)
MAPS_PROVIDER=maplibre
OCR_PROVIDER=none               # none | tesseract — текст с картинок постов (раздел 11.15)
# Tesseract — системная программа, не pip. Пока не установлен, оставь none: конвейер жив.
# Windows, после установки: OCR_PROVIDER=tesseract
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# TESSDATA_PREFIX=C:\Program Files\Tesseract-OCR\tessdata
CACHE_DRIVER=memory
STORAGE_DRIVER=external
SEARCH_DRIVER=postgres
NOTIFY_DRIVER=telegram
AUTH_DRIVER=supabase            # supabase | none — вход через переходник src/lib/adapters/auth.ts
# В Supabase → Authentication → URL Configuration:
# Site URL = NEXT_PUBLIC_SITE_URL
# Redirect: {SITE}/auth/callback , {SITE}/auth/callback?next=/auth/confirmed , {SITE}/auth/callback?next=/auth/reset
# Confirm email включён. Подробно: docs/SETUP-LOG.md, Этап 20.

# Ключи карт (нужны только если MAPS_PROVIDER=yandex)
YANDEX_MAPS_API_KEY=
YANDEX_GEOCODER_API_KEY=

# Геокодер Nominatim: честный User-Agent с названием приложения и ссылкой (правила OSM).
# Если пусто — соберём из NEXT_PUBLIC_SITE_URL или репозитория.
GEOCODE_USER_AGENT=

# Поведение сайта
NEXT_PUBLIC_DEFAULT_CITY=gorlovka
NEXT_PUBLIC_DEFAULT_QUALITY_MODE=lite
NEXT_PUBLIC_DEFAULT_STATS_VIEW=simple
NEXT_PUBLIC_SITE_URL=
# Адрес сайта для скриптов парсера (send_test.py, parser_vk.py, parser_tg.py, parser_web.py, parser_trudvsem.py). Локально — http://127.0.0.1:3000
SITE_URL=

# Парсер ВКонтакте (Этап 16). Только официальный API. Токен — секрет, не в git.
# Как получить: docs/SETUP-LOG.md, раздел «Этап 16». Юридически: docs/SOURCES-LEGAL.md
VK_TOKEN=
VK_API_VERSION=5.199
SOURCE_VK_ENABLED=true
# Пауза между запросами к API, секунды (Закон 12)
# VK_REQUEST_GAP_SEC=1.5

# Парсер Telegram (Этап 17). Client API (Telethon), не бот и не HTML t.me.
# Как получить api_id / api_hash / строку сессии: docs/SETUP-LOG.md, раздел «Этап 17».
# Юридически: docs/SOURCES-LEGAL.md. Сессию создаёт scripts/make_tg_session.py один раз локально.
TG_API_ID=
TG_API_HASH=
TG_SESSION=
SOURCE_TG_ENABLED=true
# Пауза между каналами, секунды (Закон 12). FloodWait обрабатывается отдельно — ждём, не падаем.
# TG_CHANNEL_GAP_SEC=2

# Парсер сайтов предприятий (Этап 18). HTML по CSS-селекторам из scripts/config_web.json.
# robots.txt уважаем. Браузер Playwright в CI ставится, только если javascript=true.
SOURCE_WEB_ENABLED=true
# Пауза между страницами, секунды (Закон 12). Иначе берётся pause_sec из конфига (1–3 с).
# WEB_PAUSE_SEC=2

# Парсер «Работы России» / ЦЗН (Этап 18A). Только GET JSON opendata.trudvsem.ru.
# HTML m-czn.ru и HTML trudvsem.ru не читаем. Ключа API нет.
# Юридически: docs/SOURCES-LEGAL.md, раздел «Работа России / Мой ЦЗН».
SOURCE_TRUDVSEM_ENABLED=true
# Пауза между страницами offset/limit, секунды (Закон 12). Иначе 1–3 с.
# TRUDVSEM_PAUSE_SEC=2

# Модуль поддержки проекта. false, пока сайт на бесплатном Vercel (см. разделы 5.4 и 12)
NEXT_PUBLIC_DONATIONS_ENABLED=false

# Слой ИИ для трудных объявлений (раздел 11.13). none — сайт полностью работает на правилах
AI_PROVIDER=none
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_MAX_CALLS_PER_RUN=50
AI_MIN_COMPLETENESS=60
